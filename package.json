    "test:workflow": "node --import ./scripts/service-loader.mjs --experimental-strip-types scripts/workflow-suite.ts",
    "test:media": "node --import ./scripts/service-loader.mjs --experimental-strip-types scripts/media-suite.ts",
    "test:media-progress": "node --import ./scripts/service-loader.mjs --experimental-strip-types scripts/media-progress-suite.ts",
    "test:media-timing": "node --import ./scripts/service-loader.mjs --experimental-strip-types scripts/media-timing-suite.ts",
    "test:backend": "node --import ./scripts/service-loader.mjs --experimental-strip-types scripts/backend-suite.ts",
    "test:metering": "node --import ./scripts/service-loader.mjs --experimental-strip-types scripts/metering-suite.ts",
