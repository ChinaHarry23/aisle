    "start": "next start",
    "lint": "eslint",
    "bench": "node --experimental-strip-types scripts/bench-suite.ts",
    "typecheck": "tsc --noEmit",
    "user": "node --experimental-strip-types scripts/user.ts",
    "auth": "node --experimental-strip-types scripts/auth-suite.ts",
