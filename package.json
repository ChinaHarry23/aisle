  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
