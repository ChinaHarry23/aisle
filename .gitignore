# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local auth db fallback
/data

# local render experiments (keep the workflow doc linked from README.md)
/codex/*
!/codex/ltx-2.5/
/codex/ltx-2.5/*
!/codex/ltx-2.5/STORY-AD-WORKFLOW.md

# typescript
*.tsbuildinfo
next-env.d.ts

# Local browser audit captures can contain account or Jira information.
/docs/TA-03-*.png
