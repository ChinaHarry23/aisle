# Copy to .env.local. Never commit .env.local.
# Only AUTH_SECRET is required. Every other value is optional.

# --- Auth (required) ---------------------------------------------------------
# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Database ----------------------------------------------------------------
# Leave blank in development: Aisle creates a SQLite file at ./data/aisle.db.
# In production (ephemeral filesystem) point it at a hosted Postgres. Any of
# DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, AISLE_DATABASE_URL,
# NEON_DATABASE_URL or STORAGE_URL is picked up automatically.
DATABASE_URL=
# AISLE_DB=sqlite|postgres                   # force a backend
# AISLE_DB_FILE=/absolute/path/to/aisle.db   # move the SQLite file
# AISLE_SEED_PASSWORD=                       # password for the seeded team desks

# --- Agent LLMs --------------------------------------------------------------
# Server-wide keys. Users can also add their own in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# --- Image generation --------------------------------------------------------
GOOGLE_AI_API_KEY=
BFL_API_KEY=
ARK_API_KEY=
