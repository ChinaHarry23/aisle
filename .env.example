# Copy to .env.local and fill in values if you add API keys.
# Never commit .env.local.

# Auth (required for login / signup)
AUTH_SECRET=

# Database
# Nothing is required in development: Aisle creates and migrates a SQLite file
# at ./data/aisle.db on first use (Node 22.5+ ships node:sqlite, so there is no
# native module to build).
#
# In production the filesystem is ephemeral, so point Aisle at a hosted Postgres.
# Either of these switches it over (and needs `npm install pg`):
#   DATABASE_URL=postgres://user:pass@host/db
#   AISLE_DB=postgres
# Optional overrides:
# AISLE_DB_FILE=/absolute/path/to/aisle.db   # move the SQLite file
# AISLE_SEED_PASSWORD=...                    # password for the seeded team desks

# Agent LLMs + OpenAI images
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Image
GOOGLE_AI_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=
XAI_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=
STABILITY_API_KEY=
LUMA_API_KEY=
KREA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Cloud API (optional — personal WhatsApp cannot be linked)
# Import a group chat export on /whatsapp without these.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=

# Video
RUNWAYML_API_SECRET=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
MINIMAX_API_KEY=
PIKA_API_KEY=
