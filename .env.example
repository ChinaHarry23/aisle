# Copy to .env.local and fill in values if you add API keys.
# Never commit .env.local.

# Auth (required for login / signup)
AUTH_SECRET=

# Agent LLMs + OpenAI images
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Image
GOOGLE_AI_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=
XAI_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=
STABILITY_API_KEY=
LUMA_API_KEY=
KREA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Cloud API (optional — personal WhatsApp cannot be linked)
# Import a group chat export on /whatsapp without these.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=

# Video
RUNWAYML_API_SECRET=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
MINIMAX_API_KEY=
PIKA_API_KEY=
