# Copy to .env.local. Never commit .env.local.
# Only AUTH_SECRET is required. Every other value is optional.

# --- Auth (required) ---------------------------------------------------------
# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Database ----------------------------------------------------------------
# Leave blank in development: Aisle creates a SQLite file at ./data/aisle.db.
# In production (ephemeral filesystem) point it at a hosted Postgres. Any of
# DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, AISLE_DATABASE_URL,
# NEON_DATABASE_URL or STORAGE_URL is picked up automatically.
DATABASE_URL=
# AISLE_DB=sqlite|postgres                   # force a backend
# AISLE_DB_FILE=/absolute/path/to/aisle.db   # move the SQLite file
# AISLE_SEED_PASSWORD=                       # password for the seeded team desks

# --- LangGraph traces --------------------------------------------------------
# Off unless tracing is true and a key is set. This LangSmith account is in
# APAC: the US endpoint rejects the key. Do not add a trailing slash.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aisle
# LANGSMITH_WORKSPACE_ID=
# Next.js finishes the response before a background flush, so keep this false.
# LANGCHAIN_CALLBACKS_BACKGROUND=false
# Desk launches use the Agent Server when it is up, so Studio can draw the
# same run LangSmith traces. `off` keeps the bench inside Next.js. A URL
# points at a deployed server. Unset in development means http://127.0.0.1:2024.
# AISLE_GRAPH_URL=http://127.0.0.1:2024
# LangSmith Studio (`npm run studio`) reads this file. Blank uses the dev-alex
# desk and that workspace's first draft. An id or email both work.
# AISLE_STUDIO_USER_ID=dev-alex
# AISLE_STUDIO_CAMPAIGN_ID=

# --- Agent LLMs --------------------------------------------------------------
# Server-wide keys. Users can also add their own in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# --- TA-02 Trend agent -------------------------------------------------------
# CLI example only. The website and worker always use the stored workspace model.
TA02_MODEL_ID=openai:gpt-6-luna
# For CLI tests of local:custom, set the installed local model name.
# TA02_LOCAL_MODEL=

# --- Image generation --------------------------------------------------------
GOOGLE_AI_API_KEY=
BFL_API_KEY=
ARK_API_KEY=

# --- PR #2 additions (intake, billing, OAuth, workflow, extra media) ---------
# Cindy's keys above are unchanged. These extras power PR #2-only features.

# Optional local durable service mode: npm run dev:services
# AISLE_WORKFLOW_URL=http://127.0.0.1:4171
# AISLE_WORKFLOW_SECRET=
# AISLE_WORKFLOW_PORT=4171
# AISLE_WORKFLOW_DB=/absolute/path/to/workflow.db
# AISLE_WEB_PORT=4003

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=

# AISLE_HOSTED=1
# AISLE_CLIENT_IP_HEADER=x-real-ip
# AISLE_UNLIMITED_USERS=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_API_VERSION=2026-08-26.dahlia

# AISLE_DEFAULT_BACKEND=
# LOCAL_LLM_MODEL=
# LOCAL_LLM_PROBE_URLS=
# COMFYUI_URL=http://127.0.0.1:8188
# AISLE_MEDIA_PROVIDERS=
# AISLE_MEDIA_DRIVER=

TOKENHUB_API_KEY=
DASHSCOPE_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=
XAI_API_KEY=
STABILITY_API_KEY=
LUMA_API_KEY=
KREA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUNWAYML_API_SECRET=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
MINIMAX_API_KEY=
PIKA_API_KEY=

# --- Grocery prices ----------------------------------------------------------
# Server-side WhichGrocer API key (wg_live_…). Never expose this to the browser.
WHICHGROCER_API_KEY=

# Optional server-owned JSON policy registry override. When unset, the reviewed
# official-source starter registry is used. Incomplete/unreliable coverage still
# requires manual review. Never point this at user-uploaded advertisement files.
AISLE_COMPLIANCE_RULES_FILE=

# TA-03 research: enabled on server by default; 0 disables research and leaves a partial brief.
TA03_RESEARCH_ENABLED=1
# Optional providers. Credentials are server-only, never NEXT_PUBLIC_.
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
# Configure conservative USD ceilings from YOUR current provider plan before paid calls.
# Unset/zero prices fail closed. These are estimates, not vendor price claims.
TREND_FIRECRAWL_SEARCH_MAX_USD=
TREND_FIRECRAWL_SCRAPE_MAX_USD=
TREND_SERPAPI_MAX_USD=
TREND_WHICHGROCER_MAX_USD=
TREND_RESEARCH_MAX_USD=0.25
# Optional extra trusted PUBLIC source domains (comma-separated); never internal hosts.
TREND_SOURCE_DOMAINS=

# Optional existing-model web search fallback: configured conservative per-call charge (USD).
TREND_PROVIDER_SEARCH_MAX_USD=
