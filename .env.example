# Copy to .env.local and fill in values if you add API keys.
# Never commit .env.local.

# Auth (required for login / signup)
AUTH_SECRET=

# Optional local durable service mode: npm run dev:services supplies these in memory.
# For separately launched processes, set the same 32+ character secret on API and web.
# AISLE_WORKFLOW_URL=http://127.0.0.1:4171
# AISLE_WORKFLOW_SECRET=
# AISLE_WORKFLOW_PORT=4171
# AISLE_WORKFLOW_DB=/absolute/path/to/workflow.db
# AISLE_WEB_PORT=4003

# Google and Apple sign-in.
# Redirect URIs to register with each provider (production and local):
#   https://www.aisle.website/api/auth/google/callback
#   https://www.aisle.website/api/auth/apple/callback
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/apple/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=

# Database
# Nothing is required in development: Aisle creates and migrates a SQLite file
# at ./data/aisle.db on first use (Node 22.5+ ships node:sqlite, so there is no
# native module to build).
#
# In production the filesystem is ephemeral, so point Aisle at a hosted Postgres.
# Either of these switches it over (and needs `npm install pg`):
#   DATABASE_URL=postgres://user:pass@host/db
#   AISLE_DB=postgres
# Optional overrides:
# AISLE_DB_FILE=/absolute/path/to/aisle.db   # move the SQLite file
# Team desks (role "dev"). Locally they get a demo password (`npm run user` prints it).
# On a hosted install (VERCEL=1, AISLE_HOSTED=1, or a production build on Postgres)
# they are only created when AISLE_SEED_PASSWORD is set, a desk still on the demo
# password is locked, and login refuses the demo password for a desk.
# `npm run start` on your own machine (SQLite) is NOT hosted; AISLE_HOSTED=0 forces that.
# AISLE_SEED_PASSWORD=
# Set to 1 on a public host that is not Vercel (Render, Fly, a VPS…), so it is treated as hosted.
# AISLE_HOSTED=1
# Off Vercel, the request header your own reverse proxy sets to the client address
# (e.g. x-real-ip behind nginx). Used for the per-address signup limit; unset means
# every signup shares one bucket, since clients can forge x-forwarded-for.
# AISLE_CLIENT_IP_HEADER=x-real-ip
# Hosted only: comma list of user ids or emails that spend the owner's keys without
# credits (e.g. alex@aisle.website). Unset means no one. Locally every desk is unlimited.
# AISLE_UNLIMITED_USERS=

# Credits and billing (Stripe). Users never enter API keys: cloud agents,
# posters and videos run on the owner's keys below and are paid for in credits
# ($10/month = 1,000 credits, reset on each paid invoice; free credits once per
# person; team desks are unlimited locally, or when listed in AISLE_UNLIMITED_USERS;
# local models are always free).
# Set up a sandbox with `npm run stripe:setup -- --create`; see README "Credits and billing".
# sk_test_… in development; sk_live_… (or a restricted rk_ key) in production.
STRIPE_SECRET_KEY=
# price_… for the USD $10/month price (lookup key aisle_monthly_1000).
STRIPE_PRICE_ID=
# whsec_… from `stripe listen` locally, or from the Dashboard webhook endpoint.
# Comma-separate two secrets to accept both while rolling one.
STRIPE_WEBHOOK_SECRET=
# Optional bpc_…; without it Stripe uses the Dashboard's default portal settings.
STRIPE_PORTAL_CONFIGURATION=
STRIPE_API_VERSION=2026-08-26.dahlia

# Free credits, once per person (canonical email: case, +tags and Gmail dots ignored).
# FREE_CREDITS=50             # 0 turns the free grant off
# FREE_GRANTS_PER_DAY=200     # install-wide cap on free grants per UTC day (a signup the cap
#                             # blocked is granted on a later visit within 7 days)

# Which backend new accounts start on: local | openai | anthropic (default local).
# A hosted deployment has no MTPLX/ComfyUI on loopback, so set it to a cloud backend there.
AISLE_DEFAULT_BACKEND=

# Agent LLMs (the owner's keys). The OpenAI default is GPT-6.1 Sol. Cursor has no
# public completions API, so it is not a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=mtplx-flash-next-optimized-speed
# Comma list replacing the loopback ports probed for a live local model
# (default :8000, :1234, :11434). Set it empty on a hosted deployment.
# A hosted install only ever calls these two settings (the Settings Base URL is
# ignored); locally the Settings URL must be 127.0.0.1, localhost or [::1].
# LOCAL_LLM_PROBE_URLS=

# Local ComfyUI. Posters are Z-Image Turbo. Ad videos are MiniMax H3.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_UNET=z_image_turbo_bf16.safetensors
COMFYUI_IMAGE_CLIP=qwen_3_4b.safetensors
COMFYUI_IMAGE_VAE=ae.safetensors
COMFYUI_VIDEO_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
COMFYUI_VIDEO_CLIP=qwen3vl_32b_minimax_h3_bf16.safetensors
COMFYUI_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
COMFYUI_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
COMFYUI_VIDEO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
# Set to 0 for the slower 20-step MiniMax path.
COMFYUI_VIDEO_TURBO=

# Cloud media providers. A provider is used only when it has an adapter in
# src/lib/media/providers, its key is set here, and (if set) it is listed in
# AISLE_MEDIA_PROVIDERS. Enable one only after `npm run test:providers:live`
# passes with your key. Everything else shows as "not available".
# Example: AISLE_MEDIA_PROVIDERS=openai,google,bytedance,tencent,alibaba
AISLE_MEDIA_PROVIDERS=
# Where cloud media bytes are kept: fs (AISLE_MEDIA_DIR) or db (media_objects).
# Default: db on Postgres, fs otherwise.
# AISLE_MEDIA_DRIVER=

# Wired media providers (posters + poster-to-video). OPENAI_API_KEY above also
# covers GPT Image 2 posters.
# Gemini API (Nano Banana 2 posters, Omni Flash / Veo video). GEMINI_API_KEY also works.
GOOGLE_AI_API_KEY=
# ByteDance via BytePlus ModelArk (Seedream posters, Seedance video). Switch each
# model on in the console; Seedance 2.x needs an account balance above USD 30.
ARK_API_KEY=
# Tencent via TokenHub international (Hunyuan Image, Hunyuan Video, Kling 3.0).
# Switch each model on under Online Inference > Vision Models.
TOKENHUB_API_KEY=
# Alibaba via Model Studio Singapore (Qwen Image, Wan video).
DASHSCOPE_API_KEY=

# Listed in the catalog but not wired yet: these show as "not available".
BFL_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=
XAI_API_KEY=
STABILITY_API_KEY=
LUMA_API_KEY=
KREA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUNWAYML_API_SECRET=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
MINIMAX_API_KEY=
PIKA_API_KEY=

# Test-only base URL overrides. The offline suites point these at fake servers;
# leave them unset in real use.
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
# ARK_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3
# TOKENHUB_API_BASE=https://tokenhub-intl.tencentcloudmaas.com
# DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/api/v1
# STRIPE_API_BASE=https://api.stripe.com
# Test-only timing overrides for the offline media suites:
# AISLE_MEDIA_POLL_MS=        # video poll interval
# AISLE_MEDIA_JOB_MS=         # video job deadline (default 8 minutes)
